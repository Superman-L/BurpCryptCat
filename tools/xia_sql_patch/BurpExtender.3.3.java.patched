    @Override
    public List<JMenuItem> createMenuItems(IContextMenuInvocation invocation) {
        ArrayList<JMenuItem> listMenuItems = new ArrayList<JMenuItem>(1);
        if (invocation.getToolFlag() == 64 || invocation.getToolFlag() == 4) {
            final IHttpRequestResponse[] responses = invocation.getSelectedMessages();
            JMenuItem jMenu = new JMenuItem("Send to xia SQL");
            jMenu.addActionListener(new ActionListener(){

                @Override
                public void actionPerformed(ActionEvent e) {
                    if (BurpExtender.this.switchs == 1) {
                        Thread thread = new Thread(new Runnable(){

                            @Override
                            public void run() {
                                try {
                                    BurpExtender.this.checkVul(responses[0], 1024);
                                }
                                catch (Exception ex) {
                                    ex.printStackTrace();
                                    BurpExtender.this.stdout.println(ex);
                                }
                            }
                        });
                        thread.start();
                    } else {
                        BurpExtender.this.stdout.println("\u63d2\u4ef6xia SQL\u5173\u95ed\u72b6\u6001\uff01");
                    }
                }
            });
            listMenuItems.add(jMenu);
        }
        return listMenuItems;
    }

    private void checkVul(IHttpRequestResponse baseRequestResponse, int toolFlag) {
        // ===== BurpCrypto 桥接（入口）：命中方案的加密 Body 换成明文，后面解析/注入都基于明文 =====
        byte[] bc_plain_req = xiabridge.CatBridge.decryptRequest(baseRequestResponse, this.helpers, this.callbacks);
        final IRequestInfo bc_info = bc_plain_req != null
                ? this.helpers.analyzeRequest(baseRequestResponse.getHttpService(), bc_plain_req)
                : this.helpers.analyzeRequest(baseRequestResponse);
        final byte[] bc_req = bc_plain_req != null ? bc_plain_req : baseRequestResponse.getRequest();
        String change_sign_1 = "";
        String error_sign = "";
        List<IParameter> paraLists = bc_info.getParameters();
        this.temp_data = String.valueOf(bc_info.getUrl());
        String[] temp_data_strarray = this.temp_data.split("\\?");
        String temp_data = temp_data_strarray[0];
        String[] white_URL_list = this.white_URL.split(",");
        boolean white_swith = false;
        if (this.white_switchs == 1) {
            white_swith = false;
            for (int i = 0; i < white_URL_list.length; ++i) {
                if (!temp_data.contains(white_URL_list[i])) continue;
                this.stdout.println("\u767d\u540d\u5355URL\uff01" + temp_data);
                white_swith = true;
            }
            if (!white_swith) {
                this.stdout.println("\u4e0d\u662f\u767d\u540d\u5355URL\uff01" + temp_data);
                return;
            }
        }
        if (toolFlag == 4 || toolFlag == 64) {
            String[] static_file = new String[]{"jpg", "png", "gif", "css", "js", "pdf", "mp3", "mp4", "avi"};
            String[] static_file_1 = temp_data.split("\\.");
            String static_file_2 = static_file_1[static_file_1.length - 1];
            for (String i : static_file) {
                if (!static_file_2.equals(i)) continue;
                this.stdout.println("\u5f53\u524durl\u4e3a\u9759\u6001\u6587\u4ef6\uff1a" + temp_data + "\n");
                return;
            }
            IResponseInfo responseInfo = this.callbacks.getHelpers().analyzeResponse(baseRequestResponse.getResponse());
            byte[] responseBody = Arrays.copyOfRange(baseRequestResponse.getResponse(), responseInfo.getBodyOffset(), baseRequestResponse.getResponse().length);
            ByteArrayInputStream inputStream = new ByteArrayInputStream(responseBody);
            int bytesRead = 0;
            byte[] buffer = new byte[8];
            try {
                bytesRead = inputStream.read(buffer);
            }
            catch (IOException e) {
                e.printStackTrace();
            }
            if (bytesRead >= 2 && buffer[0] == -1 && buffer[1] == -40) {
                this.stdout.println("\u5f53\u524durl\u7684\u54cd\u5e94\u5305\u4e3ajpg\u56fe\u7247\uff1a" + temp_data + "\n");
                return;
            }
            if (bytesRead >= 4 && buffer[0] == -119 && buffer[1] == 80 && buffer[2] == 78 && buffer[3] == 71) {
                this.stdout.println("\u5f53\u524durl\u7684\u54cd\u5e94\u5305\u4e3apng\u56fe\u7247\uff1a" + temp_data + "\n");
                return;
            }
            if (bytesRead >= 2 && buffer[0] == 71 && buffer[1] == 73) {
                this.stdout.println("\u5f53\u524durl\u7684\u54cd\u5e94\u5305\u4e3agif\u56fe\u7247\uff1a" + temp_data + "\n");
                return;
            }
            System.out.println("\u8fd4\u56de\u7684\u4e0d\u662f\u56fe\u7247");
        }
        String request_data = null;
        int is_add = 0;
        for (IParameter para : paraLists) {
            if (para.getType() != 0 && para.getType() != 1 && para.getType() != 6 && para.getType() != this.is_cookie) continue;
            if (is_add == 0) {
                is_add = 1;
            }
            if (para.getType() == 1) {
                String pattern = "^[a-zA-Z\\s\\d\\.~!@#$%\\^&\\*\\(\\)-_=+\\\\\\{\\}\\]:;\"',/\\?]{1,}$";
                if (!para.getName().matches(pattern)) {
                    this.stdout.println("\u5f53\u524durl\u7684body\u4e3a\u4e8c\u8fdb\u5236\uff1a" + temp_data + "\n");
                    return;
                }
            }
            temp_data = temp_data + "+" + para.getName();
            if (para.getType() != 6 || request_data != null) continue;
            try {
                request_data = this.helpers.bytesToString(bc_req).split("\r\n\r\n")[1];
                String[] request_datas = request_data.split("\\{");
                if (request_datas.length > 2) {
                    is_add = 2;
                }
                if ((request_datas = request_data.split("\":\\[")).length <= 1) continue;
                is_add = 2;
            }
            catch (Exception e) {
                this.stdout.println(e);
            }
        }
        temp_data = temp_data + "+" + bc_info.getMethod();
        this.stdout.println("\nMD5(\"" + temp_data + "\")");
        temp_data = BurpExtender.MD5(temp_data);
        this.stdout.println(temp_data);
        for (Request_md5 i : this.log4_md5) {
            if (!i.md5_data.equals(temp_data)) continue;
            if (toolFlag == 1024) {
                temp_data = String.valueOf(System.currentTimeMillis());
                this.stdout.println(temp_data);
                temp_data = BurpExtender.MD5(temp_data);
                this.stdout.println(temp_data);
                continue;
            }
            return;
        }
        if (is_add != 0) {
            this.log4_md5.add(new Request_md5(temp_data));
            this.stdout.println(is_add);
            this.stdout.println(request_data);
            int row = this.log.size();
            try {
                this.original_data_len = xiabridge.CatBridge.snapshot(this.callbacks, baseRequestResponse, bc_plain_req).getResponse().length;
                this.stdout.println(this.original_data_len);
                if (this.original_data_len <= 0) {
                    this.stdout.println("\u8be5\u6570\u636e\u5305\u65e0\u54cd\u5e94");
                    return;
                }
            }
            catch (Exception ex) {
                this.stdout.println("\u8be5\u6570\u636e\u5305\u65e0\u54cd\u5e94");
                return;
            }
            this.log.add(new LogEntry(this.conut, toolFlag, xiabridge.CatBridge.snapshot(this.callbacks, baseRequestResponse, bc_plain_req), bc_info.getUrl(), "", "", "", temp_data, 0, "run\u2026\u2026", 999));
            ++this.conut;
            this.fireTableRowsInserted(row, row);
        }
        List<IParameter> paraList = bc_info.getParameters();
        byte[] new_Request = bc_req;
        int json_count = -1;
        String para_name = "";
        for (IParameter para : paraList) {
            boolean switch_para = false;
            if (para.getType() == 6) {
                ++json_count;
            }
            ArrayList<Object> payloads = new ArrayList<Object>();
            payloads.add("'");
            payloads.add("''");
            if (para.getType() == 0 || para.getType() == 1 || para.getType() == 6 || para.getType() == this.is_cookie) {
                String key = para.getName();
                String value = para.getValue();
                this.stdout.println("\n\n\u539f\u59cb\u6570\u636e\uff1a" + key + ":" + value);
                if (this.JTextArea_int == 1) {
                    String[] JTextArea_data = this.JTextArea_data_1.split("\n");
                    payloads.clear();
                    for (String a : JTextArea_data) {
                        payloads.add(a);
                    }
                }
                if (this.is_int == 1 && value.matches("[0-9]+")) {
                    payloads.add("-1");
                    payloads.add("-0");
                }
                int change = 0;
                for (Object __o : payloads) {
                    String string = (String) __o;
                    String change_sign;
                    int time_1 = 0;
                    int time_2 = 0;
                    if (this.JTextArea_int == 1 && this.diy_payload_2 == 1 && string != "'" && string != "''" && string != "-1" && string != "-0") {
                        value = "";
                    }
                    IHttpService iHttpService = baseRequestResponse.getHttpService();
                    IHttpRequestResponse requestResponse = null;
                    if (para.getType() == 6) {
                        List<String> headers = bc_info.getHeaders();
                        if (is_add == 1) {
                            this.stdout.println("json");
                            String newBody = "{";
                            for (IParameter paras : paraList) {
                                if (paras.getType() != 6) continue;
                                if (key == paras.getName() && value == paras.getValue()) {
                                    newBody = newBody + "\"" + paras.getName() + "\":\"" + paras.getValue() + string + "\",";
                                    continue;
                                }
                                newBody = newBody + "\"" + paras.getName() + "\":\"" + paras.getValue() + "\",";
                            }
                            newBody = newBody.substring(0, newBody.length() - 1);
                            newBody = newBody + "}";
                            byte[] bodyByte = newBody.getBytes();
                            byte[] new_Requests = this.helpers.buildHttpMessage(headers, bodyByte);
                            time_1 = (int)System.currentTimeMillis();
                            requestResponse = xiabridge.CatBridge.send(this.callbacks, iHttpService, baseRequestResponse, new_Requests);
                            time_2 = (int)System.currentTimeMillis();
                        } else if (is_add == 2) {
                            request_data = request_data.replaceAll("\r", "");
                            request_data = request_data.replaceAll("\n", "");
                            String[] request_data_temp = request_data.split(",\"");
                            String request_data_body = "";
                            String request_data_body_temp = "";
                            for (int i = 0; i < request_data_temp.length; ++i) {
                                if (i == json_count) {
                                    request_data_body_temp = request_data_temp[i];
                                    this.stdout.println("\u51c6\u5907\u4fee\u6539\u7684\u503c\uff1a" + request_data_body_temp);
                                    while (request_data_body_temp.contains(":[]")) {
                                        this.stdout.println(request_data_body_temp + "\u8df3\u8fc7");
                                        request_data_body = request_data_body + "\"" + request_data_temp[i] + ",";
                                        ++json_count;
                                        request_data_body_temp = request_data_temp[++i];
                                    }
                                    if (request_data_body_temp.toLowerCase().contains(":null") || request_data_body_temp.toLowerCase().contains(":true") || request_data_body_temp.toLowerCase().contains(":false")) {
                                        this.stdout.println(request_data_body_temp + "\u8df3\u8fc7");
                                        switch_para = true;
                                        break;
                                    }
                                    if (request_data_body_temp.contains("\":")) {
                                        if (para.getName().equals(para_name)) {
                                            this.stdout.println("json\u5d4c\u5957\u5217\u8868\uff0c\u8fd9\u4e2a\u53c2\u6570\u5904\u7406\u8fc7\u4e86\uff0c\u8df3\u8fc7");
                                            --json_count;
                                            switch_para = true;
                                            break;
                                        }
                                        Pattern p = Pattern.compile(".*:\\s?\\[?\\s?(.*?$)");
                                        Matcher m = p.matcher(request_data_body_temp);
                                        if (m.find()) {
                                            request_data_body_temp = m.group(1);
                                        }
                                        if (request_data_body_temp.contains("\"")) {
                                            request_data_body_temp = request_data_temp[i];
                                            request_data_body_temp = request_data_body_temp.replaceAll("^(.*:.*?\")(.*?)(\"[^\"]*)$", "$1$2" + string + "$3");
                                            this.stdout.println(request_data_body_temp);
                                            request_data_body = request_data_body + "\"" + request_data_body_temp + ",";
                                            continue;
                                        }
                                        request_data_body_temp = request_data_temp[i];
                                        request_data_body_temp = request_data_body_temp.replaceAll("^(.*:.*?)(\\d*)([^\"\\d]*)$", "$1\"$2" + string + "\"$3");
                                        this.stdout.println(request_data_body_temp);
                                        request_data_body = request_data_body + "\"" + request_data_body_temp + ",";
                                        continue;
                                    }
                                    this.stdout.println("\u5904\u7406\u8fc7\uff0c\u65e0\u9700\u5904\u7406");
                                    switch_para = true;
                                    if (!para.getName().equals(para_name)) break;
                                    this.stdout.println("json\u5d4c\u5957\u5217\u8868\uff0c\u5df2\u7ecf\u5904\u7406\u8fc7\u7b2c\u4e00\u4e2a\u503c");
                                    break;
                                }
                                request_data_body = request_data_body + "\"" + request_data_temp[i] + ",";
                            }
                            if (switch_para) break;
                            if (para.getName().equals(para_name)) {
                                this.stdout.println("json\u5d4c\u5957\u5217\u8868\uff0c\u5df2\u7ecf\u5904\u7406\u8fc7\u7b2c\u4e00\u4e2a\u503c!!!!");
                            }
                            request_data_body = request_data_body.substring(0, request_data_body.length() - 1);
                            request_data_body = request_data_body.substring(1, request_data_body.length());
                            byte[] bodyByte = request_data_body.getBytes();
                            byte[] new_Requests = this.helpers.buildHttpMessage(headers, bodyByte);
                            time_1 = (int)System.currentTimeMillis();
                            requestResponse = xiabridge.CatBridge.send(this.callbacks, iHttpService, baseRequestResponse, new_Requests);
                            time_2 = (int)System.currentTimeMillis();
                        }
                    } else {
                        this.stdout.println("\u666e\u901a\u683c\u5f0f");
                        IParameter newPara = this.helpers.buildParameter(key, value + string, para.getType());
                        byte[] newRequest = this.helpers.updateParameter(new_Request, newPara);
                        time_1 = (int)System.currentTimeMillis();
                        requestResponse = xiabridge.CatBridge.send(this.callbacks, iHttpService, baseRequestResponse, newRequest);
                        time_2 = (int)System.currentTimeMillis();
                    }
                    if (string == "'" || string == "-1" || change == 0) {
                        change = requestResponse.getResponse().length;
                        change_sign = "";
                    } else if (string == "''" || string == "-0") {
                        if (change != requestResponse.getResponse().length) {
                            if (string == "''" && requestResponse.getResponse().length == this.original_data_len || string == "-0" && requestResponse.getResponse().length == this.original_data_len) {
                                change_sign = "\u2714 ==> ?";
                                change_sign_1 = " \u2714";
                            } else {
                                change_sign = "\u2714 " + (change - requestResponse.getResponse().length);
                                change_sign_1 = " \u2714";
                            }
                        } else {
                            change_sign = "";
                        }
                    } else if (time_2 - time_1 >= 3000) {
                        change_sign = "time > 3";
                        change_sign_1 = " \u2714";
                    } else {
                        change_sign = "diy payload";
                    }
                    for (String keyword : this.diy_error_text.split("\n")) {
                        Pattern patterns = Pattern.compile(keyword);
                        if (!patterns.matcher(this.helpers.bytesToString(requestResponse.getResponse())).find()) continue;
                        error_sign = " Err";
                        change_sign = change_sign + " Err";
                        this.log_text.insert(String.valueOf(this.conut - 1) + "-->diy_error:" + keyword + "\n", 0);
                        break;
                    }
                    this.log2.add(new LogEntry(this.conut, toolFlag, this.callbacks.saveBuffersToTempFiles(requestResponse), this.helpers.analyzeRequest(requestResponse).getUrl(), key, value + string, change_sign, temp_data, time_2 - time_1, "end", this.helpers.analyzeResponse(requestResponse.getResponse()).getStatusCode()));
                }
            }
            para_name = para.getName();
            this.stdout.println(json_count);
        }
        for (int i = 0; i < this.log.size(); ++i) {
            if (!temp_data.equals(this.log.get((int)i).data_md5)) continue;
            this.log.get(i).setState("end!" + change_sign_1 + error_sign);
        }
        this.fireTableDataChanged();
        this.logTable.setRowSelectionInterval(this.select_row, this.select_row);
    }

